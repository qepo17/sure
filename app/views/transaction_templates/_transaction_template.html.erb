<%# locals: (transaction_template:) %>
<div id="<%= dom_id(transaction_template) %>" class="flex justify-between items-center p-4 bg-container">
  <p class="text-primary text-sm truncate"><%= transaction_template.name %></p>
  <div class="justify-self-end">
    <%= render DS::Menu.new do |menu| %>
      <% menu.with_item(variant: 'link', text: t('.edit'), href: edit_transaction_template_path(transaction_template), icon: 'pencil', data: { turbo_frame: 'modal' }) %>
      <% menu.with_item(variant: 'button', text: t('.delete'), href: transaction_template_path(transaction_template), icon: 'trash-2', method: :delete, confirm: CustomConfirm.for_resource_deletion(transaction_template.name)) %>
    <% end %>
  </div>
</div>
